!/vercel.json
!/dist
/dist/*
!/dist/microverse.html
!/dist/microverse.js
!/dist/picker.js
!/dist/favicon.svg
!/microverse
/microverse/*
!/microverse/sim.mjs
!/microverse/strains.mjs
!/microverse/config.mjs
